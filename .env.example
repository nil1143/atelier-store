# Copy to .env.local and fill in values. Never commit real secrets.

# Neon Postgres connection string (Neon console -> Connect). Use the pooled URL.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth
# Generate a secret with: npx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of the app (server-side)
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the browser auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
